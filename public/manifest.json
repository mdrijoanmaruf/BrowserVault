{
  "manifest_version": 3,
  "name": "BrowserVault",
  "version": "1.0.0",
  "description": "Secure your browser with a lock screen.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "idle",
    "tabs",
    "notifications",
    "alarms",
    "history",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://browser-vault-backend.vercel.app/*",
    "https://*.workers.dev/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open BrowserVault popup"
    },
    "panic-lock": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Lock browser immediately (Panic Lock)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["index.html", "lock.html", "icons/*"]
    }
  ]
}
