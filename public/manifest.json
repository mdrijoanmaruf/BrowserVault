{
  "manifest_version": 3,
  "name": "BrowserVault",
  "version": "1.0.0",
  "description": "Secure your browser with a lock screen.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "idle",
    "tabs",
    "notifications"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
